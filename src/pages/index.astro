---
import Base from "../layouts/Base.astro";
import Art from "../components/Art.astro";
import site from "../data/site.json";
import { byId, doiUrl, surnames } from "../lib/pubs";

// Split the cat photos into two columns of similar height (in page order).
const catColumns: (typeof site.cats)[] = [[], []];
const colHeight = [0, 0];
for (const cat of site.cats) {
  const i = colHeight[0] <= colHeight[1] ? 0 : 1;
  catColumns[i].push(cat);
  colHeight[i] += cat.h / cat.w;
}
const featured = site.featuredPublications.map((f) => ({ ...byId(f.id), art: f.art }));
---

<Base>
  <section class="hero" aria-labelledby="name">
    <div class="hero-copy">
      <h1 id="name">Xinning<br />Gui</h1>
      <p class="fields">{site.fields.join(" · ")}</p>
      <p class="summary">{site.summary}</p>
      <ul class="roles">{site.roles.map((role) => <li>{role}</li>)}</ul>
      <ul class="quick-links">
        <li><a href="/publications/">All publications <span aria-hidden="true">→</span></a></li>
        <li><a href={site.links.scholar}>Google Scholar <span aria-hidden="true">↗</span></a></li>
      </ul>
    </div>
    <div class="portrait">
      <img src="/images/xinning-gui.jpg" alt="Portrait of Xinning Gui" width="730" height="900" />
    </div>
  </section>

  <section class="section" id="research" aria-labelledby="research-h">
    <div class="section-head"><h2 id="research-h">Research</h2></div>
    <div class="panel">
      <div class="segmented" role="tablist" aria-label="Research threads" data-tabs>
        {site.threads.map((thread, i) => (
          <button type="button" role="tab" id={`tab-${thread.id}`} aria-controls={`panel-${thread.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{thread.short}</button>
        ))}
      </div>
      {site.threads.map((thread) => (
        <article class="thread-panel" role="tabpanel" id={`panel-${thread.id}`} aria-labelledby={`tab-${thread.id}`} tabindex="0">
          <div class="tile" style={`background:${thread.tint}`}><Art name={thread.art} /></div>
          <div class="thread-text">
            <h3>{thread.title}</h3>
            <p>{thread.text}</p>
            <p class="selected-label">Selected papers</p>
            <ul class="selected">
              {thread.papers.map((id) => {
                const p = byId(id);
                const url = doiUrl(p);
                const title = p.title.split(/: (?=[A-Z“])/)[0];
                return <li><span class="sel-venue">{p.short}</span>{url ? <a href={url}>{title}</a> : title}</li>;
              })}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="recent-h">
    <div class="section-head">
      <h2 id="recent-h">Recent publications</h2>
      <ul class="head-links">
        <li><a class="text-link" href="/publications/">All publications <span aria-hidden="true">→</span></a></li>
        <li><a class="text-link" href={site.links.scholar}>Google Scholar <span aria-hidden="true">↗</span></a></li>
      </ul>
    </div>
    <div class="pub-grid">
      {featured.map((p) => {
        const url = doiUrl(p);
        return (
          <article class="pub-card">
            <div class="tile-white"><Art name={p.art} /></div>
            <p class="venue">{p.short}</p>
            <h3>{url ? <a href={url}>{p.title}</a> : p.title}</h3>
            <p class="authors">{surnames(p)}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section" id="students" aria-labelledby="students-h">
    <div class="section-head">
      <h2 id="students-h">Students</h2>
      <p class="head-note">With <a class="inline" href="https://yubokou.github.io/">Dr. Yubo Kou</a>, I co-direct the <a class="inline" href={site.links.lab}>Health and Play Lab</a>.</p>
    </div>
    <ul class="student-grid">
      {site.students.map((s) => (
        <li class="student">
          <img src={s.photo} alt="" width="600" height="750" loading="lazy" decoding="async" />
          <h3>{s.url ? <a class="inline" href={s.url}>{s.name}</a> : s.name}</h3>
          <p class="meta">{s.status} · since {s.since}</p>
          <p class="focus">{s.focus}</p>
        </li>
      ))}
    </ul>
    <div class="alumni">
      <h3>Alumni</h3>
      <ul>
        {site.alumni.map((a) => <li><b>{a.name}</b>, {a.degree} (advised {a.years}). {a.note}.</li>)}
      </ul>
    </div>
  </section>

  <section class="section personal" id="personal" aria-labelledby="personal-h">
    <div class="personal-text">
      <h2 id="personal-h">Personal life</h2>
      {site.personal.map((para) => <p>{para}</p>)}
    </div>
    <div class="cat-gallery" role="group" aria-label="Photos of Teemo and Melon">
      {catColumns.map((col) => (
        <ul class="cat-col">
          {col.map((cat) => (
            <li><figure><img src={cat.src} alt={cat.alt} width={cat.w} height={cat.h} loading="lazy" decoding="async" /><figcaption>{cat.caption}</figcaption></figure></li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      // Research: tabs styled as a segmented control (arrow keys move between threads).
      const tablist = document.querySelector("[data-tabs]");
      if (tablist) {
        const tabs = [...tablist.querySelectorAll('[role="tab"]')];
        const select = (tab) => {
          tabs.forEach((t) => {
            const on = t === tab;
            t.setAttribute("aria-selected", on ? "true" : "false");
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
          });
        };
        tabs.forEach((t, i) => {
          t.addEventListener("click", () => select(t));
          t.addEventListener("keydown", (e) => {
            const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
            if (!d) return;
            const next = tabs[(i + d + tabs.length) % tabs.length];
            select(next);
            next.focus();
          });
        });
        select(tabs[0]);
      }
    })();
  </script>
</Base>
