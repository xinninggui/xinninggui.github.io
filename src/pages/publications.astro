---
import Base from "../layouts/Base.astro";
import { allPublications, doiUrl, isFullPaper, typeLabels } from "../lib/pubs";

const years = [...new Set(allPublications.map((p) => p.year))].sort((a, b) => b - a);
---

<Base title="Publications" current="publications" description="Publications by Xinning Gui: journal articles, conference papers, posters, and workshop papers.">
  <div class="page-head">
    <h1>Publications</h1>
  </div>

  <form class="filters" id="filters" role="search" aria-label="Filter publications">
    <label class="grow">Search
      <input type="search" name="q" placeholder="Title, author, venue, or year" autocomplete="off" />
    </label>
    <fieldset class="type-chips">
      <legend>Type</legend>
      {[["", "All"], ["full", "Full papers"], ["journal", "Journal"], ["conference", "Conference"], ["short", "Posters & workshops"]].map(([v, label], i) => (
        <label class="chip"><input type="radio" name="type" value={v} checked={i === 0} /><span>{label}</span></label>
      ))}
    </fieldset>
    <label class="switch"><input type="checkbox" name="award" role="switch" /><span class="track" aria-hidden="true"></span><span>Award papers only</span></label>
    <button type="reset">Reset</button>
  </form>
  <p class="count" id="count" role="status" aria-live="polite">{allPublications.length} publications</p>

  <div id="list">
    {years.map((year) => (
      <section class="year-group" data-year-group aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`}>{year}</h2>
        <ol>
          {allPublications.filter((p) => p.year === year).map((p) => {
            const url = doiUrl(p);
            const full = isFullPaper(p);
            return (
              <li class="entry" data-type={p.type} data-full={full ? "yes" : "no"} data-award={p.award ? "yes" : "no"}
                data-search={`${p.title} ${p.authors.join(" ")} ${p.short} ${p.venue} ${p.year}`.toLowerCase()}>
                <div class="tags">
                  <span class="tag">{p.short}</span>
                  <span class={`tag ${full ? "tag-full" : "tag-short"}`}>{typeLabels[p.type]}</span>
                  {p.award && <span class="tag tag-award">★ {p.award}</span>}
                </div>
                <h3>{url ? <a href={url}>{p.title}</a> : p.title}</h3>
                <p class="authors">{p.authors.map((a, i) => (
                  <>{i > 0 && (i === p.authors.length - 1 ? (p.authors.length > 2 ? ", and " : " and ") : ", ")}{a === "Xinning Gui" ? <b>{a}</b> : a}</>
                ))}</p>
                <p><span class="where">{p.venue}</span>{p.details ? `, ${p.details}` : ""}</p>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </div>
  <p class="empty" id="empty" hidden>No publications match. <button type="reset" form="filters" class="text-link" style="background:none;border:0;font:inherit;cursor:pointer;color:inherit">Clear filters</button></p>

  <script is:inline>
    (() => {
      const form = document.getElementById("filters");
      const entries = [...document.querySelectorAll(".entry")];
      const groups = [...document.querySelectorAll("[data-year-group]")];
      const count = document.getElementById("count");
      const empty = document.getElementById("empty");
      const norm = (t) => t.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[‘’“”"']/g, "").replace(/[‐-―-]/g, " ");
      entries.forEach((e) => (e.dataset.n = norm(e.dataset.search)));
      const apply = () => {
        const words = norm(form.q.value).split(/\s+/).filter(Boolean);
        const type = form.type.value;
        const award = form.award.checked;
        let n = 0;
        entries.forEach((e) => {
          const ok = words.every((w) => e.dataset.n.includes(w)) &&
            (!type || (type === "full" ? e.dataset.full === "yes" : type === "short" ? e.dataset.full === "no" : e.dataset.type === type)) &&
            (!award || e.dataset.award === "yes");
          e.hidden = !ok;
          if (ok) n++;
        });
        groups.forEach((g) => (g.hidden = !g.querySelector(".entry:not([hidden])")));
        count.textContent = `${n} publication${n === 1 ? "" : "s"}`;
        empty.hidden = n !== 0;
      };
      form.addEventListener("input", apply);
      form.addEventListener("change", apply);
      form.addEventListener("reset", () => requestAnimationFrame(apply));
      form.addEventListener("submit", (e) => e.preventDefault());
    })();
  </script>
</Base>
