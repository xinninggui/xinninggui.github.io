---
import "@fontsource/libre-franklin/400.css";
import "@fontsource/libre-franklin/500.css";
import "@fontsource/libre-franklin/600.css";
import "@fontsource/libre-franklin/800.css";
import "@fontsource/libre-franklin/900.css";
import "../styles/site.css";
import "../styles/themes/wabicat.css";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  current?: "home" | "publications";
}
const { title, description = site.description, current = "home" } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} · Penn State`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const home = current === "home" ? "" : "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/images/xinning-gui.jpg", Astro.site).href} />
    <meta name="theme-color" content="#EEEBE5" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="site-header" id="top">
        <a class="brand" href="/">{site.name}</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
        <nav aria-label="Main" id="main-nav">
          <ul>
            <li><a href={`${home}#research`}>Research</a></li>
            <li><a href="/publications/" aria-current={current === "publications" ? "page" : undefined}>Publications</a></li>
            <li><a href={`${home}#students`}>Students</a></li>
            <li><a href={`${home}#personal`}>Personal life</a></li>
            <li><a href={`${home}#contact`}>Contact</a></li>
          </ul>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer" id="contact">
        <div>
          <h2>Contact</h2>
          <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
          <p>{site.office}</p>
        </div>
        <ul class="footer-links">
          {site.links.cv && <li><a href={site.links.cv}>CV</a></li>}
          <li><a href={site.links.scholar}>Google Scholar</a></li>
          <li><a href={site.links.lab}>Health and Play Lab</a></li>
          <li><a class="to-top" href="#top">Back to top ↑</a></li>
        </ul>
        <p class="updated">Last updated {site.lastUpdated}</p>
        <span class="enso-z" aria-hidden="true"><i>z</i><i>z</i><i>z</i></span>
      </footer>
    </div>
    <div class="paw-walk" aria-hidden="true"></div>
    <p class="paw-note" role="status" aria-live="polite"></p>
    <script is:inline>
      (() => {
        const header = document.querySelector(".site-header");
        const update = () => header.classList.toggle("scrolled", window.scrollY > 8);
        update();
        window.addEventListener("scroll", update, { passive: true });
        // Phones: the menu folds into one button so the sticky header stays one line.
        const toggle = header.querySelector(".menu-toggle");
        const setOpen = (open) => { toggle.setAttribute("aria-expanded", String(open)); header.classList.toggle("menu-open", open); };
        toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
        header.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
        // Clay cat: each pat gets a different small reply.
        const cat = document.querySelector(".clay-cat");
        if (cat) {
          const says = ["mrrp", "prrr…", "mew", "…", "purr"];
          let n = 0;
          cat.addEventListener("click", () => {
            const say = cat.querySelector(".cc-say");
            say.textContent = says[n++ % says.length];
            cat.classList.remove("petted"); void cat.offsetWidth; cat.classList.add("petted");
          });
        }
        // Melon's paw prints: they cross the screen once when a visitor reaches Personal life,
        // and again whenever someone mashes the keyboard (as Melon does).
        const walk = document.querySelector(".paw-walk"), note = document.querySelector(".paw-note");
        let walking = false;
        const pawWalk = (message) => {
          if (walking) return;
          walking = true;
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          const steps = reduce ? 0 : Math.ceil(innerWidth / 70) + 2;
          walk.innerHTML = "";
          for (let i = 0; i < steps; i++) {
            const p = document.createElement("span");
            p.style.left = (i * 70 - 40) + "px"; p.style.bottom = (i % 2 ? 26 : 8) + "px"; p.style.animationDelay = (i * 0.12) + "s";
            walk.appendChild(p);
          }
          note.textContent = message;
          note.classList.add("show");
          setTimeout(() => { note.classList.remove("show"); walk.innerHTML = ""; walking = false; }, Math.max(3200, steps * 120 + 1600));
        };
        // Watch the section heading, not the whole section: on phones the section is taller than
        // the screen, so a share-of-section threshold would never be reached.
        const personal = document.getElementById("personal-h");
        if (personal && "IntersectionObserver" in window) {
          const io = new IntersectionObserver((entries) => {
            if (entries.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(() => pawWalk("Melon just walked by."), 400); }
          }, { threshold: 1, rootMargin: "0px 0px -20% 0px" });
          io.observe(personal);
        }
        let presses = [];
        document.addEventListener("keydown", (e) => {
          const t = e.target;
          if (walking || e.metaKey || e.ctrlKey || e.altKey || e.key.length !== 1 || (t.closest && t.closest("input, textarea, select, [contenteditable]"))) return;
          const now = Date.now();
          presses = presses.filter((p) => now - p < 1200); presses.push(now);
          if (presses.length < 7) return;
          presses = [];
          pawWalk("Melon just walked across the keyboard.");
        });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && header.classList.contains("menu-open")) { setOpen(false); toggle.focus(); } });
      })();
    </script>
  </body>
</html>
