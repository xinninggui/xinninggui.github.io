---
// The small clay cat that sits on the Research line. Hover: tail sways. Click: ears twitch and it says something.
---
<button class="clay-cat" type="button" aria-label="Pet the cat">
  <svg viewBox="0 0 110 124" aria-hidden="true">
    <g class="cc-tail"><path d="M84 119 C104 119 106 96 95 88" fill="none" stroke="#8E735A" stroke-width="7" stroke-linecap="round"/></g>
    <path d="M18 120 C12 84 28 56 50 56 C74 56 90 86 84 120 Z" fill="#B59A7E"/>
    <g class="cc-ears"><path d="M33 34 L35 11 L48 23 Z M53 23 L66 11 L68 34 Z" fill="#8E735A" stroke="#8E735A" stroke-width="3" stroke-linejoin="round"/></g>
    <circle cx="50.5" cy="38" r="19" fill="#8E735A"/>
  </svg>
  <span class="cc-say" aria-live="polite"></span>
</button>
